# Copy to frontend/.env.local and fill in real values.
# Never commit frontend/.env.local.

# API base URL used by the browser (must be reachable from the client)
NEXT_PUBLIC_API_URL=http://localhost:1234

# Site hostname without protocol (used for sitemap, robots, and Open Graph)
# Defaults to useabstractions.com if unset
# NEXT_PUBLIC_SITE_URL=localhost:3000

# PostHog web analytics. Disabled by default (recommended for self-hosted).
# Must be exactly "true" and include a project key to enable.
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_ANALYTICS_KEY=phc_...
# First-party proxy path used as the SDK api_host (default /p)
# NEXT_PUBLIC_ANALYTICS_PROXY_PATH=/p
