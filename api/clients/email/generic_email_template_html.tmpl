<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="color-scheme: light;">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title></title>
    <style type="text/css" rel="stylesheet" media="all">
      /* Base ------------------------------ */
      body {
        width: 100% !important;
        height: 100%;
        margin: 0;
        -webkit-text-size-adjust: none;
      }

      a {
        color: {{ .PrimaryColor }} !important;
      }

      a img {
        border: none;
      }

      td {
        word-break: break-word;
      }

      .preheader {
        display: none !important;
        visibility: hidden;
        mso-hide: all;
        font-size: 1px;
        line-height: 1px;
        max-height: 0;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
      }
      /* Type ------------------------------ */

      body,
      td,
      th {
        font-family: Helvetica, Arial, sans-serif;
      }

      h1 {
        margin-top: 0;
        margin-bottom: 1.25em;
        color: #111111;
        font-size: 30px;
        font-weight: bold;
        text-align: left;
        line-height: 1.25;
      }

      h2 {
        margin-top: 0;
        color: #111111;
        font-size: 18px;
        font-weight: bold;
        text-align: left;
      }

      h3 {
        margin-top: 0;
        color: #111111;
        font-size: 15px;
        font-weight: bold;
        text-align: left;
      }

      td,
      th {
        font-size: 18px;
      }

      p,
      ul,
      ol,
      blockquote {
        margin: 0.4em 0 1.375em;
        font-size: 18px;
        line-height: 1.75;
      }

      p.sub {
        font-size: 13px;
      }
      /* Utilities ------------------------------ */

      .align-right {
        text-align: right;
      }

      .align-left {
        text-align: left;
      }

      .align-center {
        text-align: center;
      }

      .u-margin-bottom-none {
        margin-bottom: 0;
      }
      /* Buttons ------------------------------ */

      .button {
        background-color: {{ .PrimaryColor }};
        border-top: 10px solid {{ .PrimaryColor }};
        border-right: 18px solid {{ .PrimaryColor }};
        border-bottom: 10px solid {{ .PrimaryColor }};
        border-left: 18px solid {{ .PrimaryColor }};
        display: inline-block;
        color: #fff !important;
        text-decoration: none;
        border-radius: 3px;
        box-shadow: 0 2px 3px rgba(0, 0, 0, 0.16);
        -webkit-text-size-adjust: none;
        box-sizing: border-box;
      }

      .button a {
        color: #fff !important;
      }

      @media only screen and (max-width: 500px) {
        .button {
          width: 100% !important;
          text-align: center !important;
        }
      }
      /* Attribute list ------------------------------ */

      .attributes {
        margin: 0 0 21px;
      }

      .attributes_content {
        background-color: #f4f4f7;
        padding: 16px;
      }

      .attributes_item {
        padding: 0;
      }
      /* Related Items ------------------------------ */

      .related {
        width: 100%;
        margin: 0;
        padding: 25px 0 0 0;
        -premailer-width: 100%;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
      }

      .related_item {
        padding: 10px 0;
        color: #cbcccf;
        font-size: 15px;
        line-height: 18px;
      }

      .related_item-title {
        display: block;
        margin: 0.5em 0 0;
      }

      .related_item-thumb {
        display: block;
        padding-bottom: 10px;
      }

      .related_heading {
        border-top: 1px solid #cbcccf;
        text-align: center;
        padding: 25px 0 10px;
      }
      /* Social Icons ------------------------------ */

      .social {
        width: auto;
      }

      .social td {
        padding: 0;
        width: auto;
      }

      .social_icon {
        height: 20px;
        margin: 0 8px 10px 8px;
        padding: 0;
      }
    
      body {
        background-color: #ffffff;
        color: #292929;
      }

      p {
        color: #292929;
      }

      .email-wrapper {
        width: 100%;
        margin: 0;
        padding: 0;
        -premailer-width: 100%;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
        background-color: #ffffff;
      }

      .email-content {
        width: 100%;
        margin: 0;
        padding: 0;
        -premailer-width: 100%;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
      }
      /* Masthead ----------------------- */

      .email-masthead {
        padding: 32px 0;
        text-align: center;
        border-bottom: 1px solid #eaeaec;
      }

      .email-masthead_logo {
        width: 180px;
        max-width: 180px;
      }

      .email-masthead_name {
        font-size: 16px;
        font-weight: bold;
        color: #A8AAAF;
        text-decoration: none;
        text-shadow: 0 1px 0 white;
      }
      /* Body ------------------------------ */

      .email-body {
        width: 100%;
        margin: 0;
        padding: 0;
        -premailer-width: 100%;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
      }

      .email-body_inner {
        width: 680px;
        max-width: 680px;
        margin: 0 auto;
        padding: 0;
        -premailer-width: 680px;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
        background-color: #ffffff;
        border-top: 3px solid {{ .PrimaryColor }};
      }

      .email-footer {
        width: 680px;
        max-width: 680px;
        margin: 0 auto;
        padding: 0;
        -premailer-width: 680px;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
        text-align: center;
      }

      .email-footer p {
        color: #A8AAAF;
      }

      .email-footer .content-cell {
        padding-top: 24px;
        border-top: 1px solid #eaeaec;
      }

      .body-action {
        width: 100%;
        margin: 30px auto;
        padding: 0;
        -premailer-width: 100%;
        -premailer-cellpadding: 0;
        -premailer-cellspacing: 0;
        text-align: center;
      }

      .body-sub {
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid #eaeaec;
      }

      .content-cell {
        padding: 40px 48px;
      }
      /*Media Queries ------------------------------ */

      @media only screen and (max-width: 680px) {
        .email-body_inner,
        .email-footer {
          width: 100% !important;
          max-width: 100% !important;
        }

        .content-cell {
          padding: 24px !important;
        }

        .email-masthead_logo {
          width: 140px !important;
          max-width: 140px !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        body,
        .email-wrapper,
        .email-content,
        .email-body_inner,
        .email-body,
        .email-masthead {
          background-color: #ffffff !important;
          color: #292929 !important;
        }

        h1, h2, h3 {
          color: #111111 !important;
        }

        p {
          color: #292929 !important;
        }

        .email-footer p {
          color: #A8AAAF !important;
        }
      }

      :root {
        color-scheme: light;
        supported-color-schemes: light;
      }

      /* AI-generated content styles ------------------------------ */

      .f-fallback h2 {
        margin-top: 2em;
        margin-bottom: 0.6em;
        color: #111111;
        font-size: 24px;
        font-weight: bold;
        line-height: 1.3;
        text-align: left;
      }

      .f-fallback h2:first-child {
        margin-top: 0;
      }

      .f-fallback h3 {
        margin-top: 1.5em;
        margin-bottom: 0.4em;
        color: #111111;
        font-size: 19px;
        font-weight: bold;
        line-height: 1.3;
        text-align: left;
      }

      .f-fallback ul,
      .f-fallback ol {
        margin: 0.5em 0 1.375em;
        padding-left: 1.5em;
        font-size: 18px;
        line-height: 1.75;
        color: #292929;
      }

      .f-fallback li {
        margin-bottom: 0.5em;
      }

      .f-fallback code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.85em;
        background-color: #f6f7f8;
        color: #333333;
        padding: 0.15em 0.45em;
        border-radius: 3px;
        border: 1px solid #e2e4e8;
      }

      .f-fallback pre {
        background-color: #f6f7f8;
        border-radius: 4px;
        border-left: 3px solid {{ .PrimaryColor }};
        padding: 16px 20px;
        margin: 1.25em 0 1.375em;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-all;
      }

      .f-fallback pre code {
        background-color: transparent;
        padding: 0;
        border: none;
        font-size: 0.8125em;
        line-height: 1.6;
        color: #333333;
      }
    </style>
    <!--[if mso]>
      <style type="text/css">
        .f-fallback {
          font-family: Arial, sans-serif;
        }
      </style>
    <![endif]-->
  </head>
  <body>
    <span class="preheader"
      >Your latest codebase insights from Abstractions.</span
    >
    <table
      class="email-wrapper"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
    >
      <tr>
        <td align="center">
          <table
            class="email-content"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            role="presentation"
          >
            <tr>
              <td class="email-masthead">
                <a
                  href="{{ .SenderLink }}"
                  class="f-fallback email-masthead_name"
                >
                 <img
                   src="{{ .SenderLogo }}"
                   alt="{{ .SenderName }}"
                   width="180"
                   height="auto"
                   class="email-masthead_logo"
                   style="width: 180px; max-width: 100%; height: auto; display: block; margin: 0 auto;"
                 />
                </a>
              </td>
            </tr>
            <!-- Email Body -->
            <tr>
              <td
                class="email-body"
                width="680"
                cellpadding="0"
                cellspacing="0"
              >
                <table
                  class="email-body_inner"
                  align="center"
                  width="680"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                >
                  <!-- Body content -->
                  <tr>
                    <td class="content-cell">
                      <div class="f-fallback">
                        {{ if .Title }}
                        <h1>{{ .Title }}</h1>
                        {{ end }}
                        {{ .BodyHTML }}
                        <!-- Action -->
                        {{ if .CTAText }}
                        <table
                          class="body-action"
                          align="center"
                          width="100%"
                          cellpadding="0"
                          cellspacing="0"
                          role="presentation"
                        >
                          <tr>
                            <td align="left">
                              <!-- Border based button
           https://litmus.com/blog/a-guide-to-bulletproof-buttons-in-email-design -->
                              <table
                                width="100%"
                                border="0"
                                cellspacing="0"
                                cellpadding="0"
                                role="presentation"
                              >
                                <tr>
                                  <td align="left">
                                    <a
                                      href="{{ .CTALink }}"
                                      class="f-fallback button"
                                      target="_blank"
                                      >{{ .CTAText }}</a
                                    >
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>
                        {{ end }}
                        <!-- Sub copy -->
                        {{ if .CTALink }}
                        <table class="body-sub" role="presentation">
                          <tr>
                            <td>
                              <p class="f-fallback sub">
                                If you're having trouble with the button above,
                                copy and paste the URL below into your web
                                browser.
                              </p>
                              <p class="f-fallback sub">{{ .CTALink }}</p>
                            </td>
                          </tr>
                        </table>
                        {{ end }}
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td>
                <table
                  class="email-footer"
                  align="center"
                  width="680"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                >
                  <tr>
                    <td class="content-cell" align="left">
                      <p class="f-fallback sub align-left">
                        {{ .EmailReason }}
                      </p>
                      <p class="f-fallback sub align-left">
                        {{ .SenderLegalName }}
                        <br />
                        {{ .SenderAddress }}
                        <br />
                        {{ if .UnsubscribeLink }}
                        <a href="{{ .UnsubscribeLink }}" class="f-fallback">
                          Unsubscribe
                        </a>
                        {{ end }} {{ if .PreferencesLink }} |
                        <a href="{{ .PreferencesLink }}" class="f-fallback">
                          Manage Preferences
                        </a>
                        {{ end }}
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
