<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="color-scheme: light;">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{ .SenderName }}</title>
    <!--
      NOTE: Critical layout and visual styles are inlined directly on each element
      below so they survive email clients that strip or ignore <head><style> (Gmail
      for non-Google-hosted domains, Outlook desktop, etc.). The <style> block here is
      kept ONLY for rules that cannot be inlined per element: responsive @media
      queries, dark-mode/color-scheme hints, the MSO conditional, and the .f-fallback
      rules that style AI-generated newsletter content (whose elements have no inline
      styles). Do not move layout styling back into classes-only.
    -->
    <style type="text/css" rel="stylesheet" media="all">
      /* Base ------------------------------ */
      body {
        width: 100% !important;
        height: 100%;
        margin: 0;
        -webkit-text-size-adjust: none;
        background-color: #ffffff;
        color: #292929;
      }

      a {
        color: {{ .PrimaryColor }} !important;
      }

      a img {
        border: none;
      }

      td {
        word-break: break-word;
      }

      body,
      td,
      th {
        font-family: Helvetica, Arial, sans-serif;
      }

      .preheader {
        display: none !important;
        visibility: hidden;
        mso-hide: all;
        font-size: 1px;
        line-height: 1px;
        max-height: 0;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
      }
      /* Media Queries ------------------------------ */

      @media only screen and (max-width: 500px) {
        .button {
          width: 100% !important;
          text-align: center !important;
        }
      }

      @media only screen and (max-width: 680px) {
        .email-body_inner,
        .email-footer {
          width: 100% !important;
          max-width: 100% !important;
        }

        .content-cell {
          padding: 24px !important;
        }

        .email-masthead_logo {
          width: 140px !important;
          max-width: 140px !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        body,
        .email-wrapper,
        .email-content,
        .email-body_inner,
        .email-body,
        .email-masthead {
          background-color: #ffffff !important;
          color: #292929 !important;
        }

        h1, h2, h3 {
          color: #111111 !important;
        }

        p {
          color: #292929 !important;
        }

        .email-footer p {
          color: #A8AAAF !important;
        }
      }

      :root {
        color-scheme: light;
        supported-color-schemes: light;
      }

      /* AI-generated content styles (newsletter body) ------------------------------ */
      /* These style raw AI/markdown HTML that has no inline styles, so they must live
         here. Newsletter content degrades to readable default text if stripped. */

      .f-fallback h2 {
        margin-top: 2em;
        margin-bottom: 0.6em;
        color: #111111;
        font-size: 24px;
        font-weight: bold;
        line-height: 1.3;
        text-align: left;
      }

      .f-fallback h2:first-child {
        margin-top: 0;
      }

      .f-fallback h3 {
        margin-top: 1.5em;
        margin-bottom: 0.4em;
        color: #111111;
        font-size: 19px;
        font-weight: bold;
        line-height: 1.3;
        text-align: left;
      }

      .f-fallback p {
        margin: 0.4em 0 1.375em;
        font-size: 18px;
        line-height: 1.75;
        color: #292929;
      }

      .f-fallback ul,
      .f-fallback ol {
        margin: 0.5em 0 1.375em;
        padding-left: 1.5em;
        font-size: 18px;
        line-height: 1.75;
        color: #292929;
      }

      .f-fallback li {
        margin-bottom: 0.5em;
      }

      .f-fallback code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.85em;
        background-color: #f6f7f8;
        color: #333333;
        padding: 0.15em 0.45em;
        border-radius: 3px;
        border: 1px solid #e2e4e8;
      }

      .f-fallback pre {
        background-color: #f6f7f8;
        border-radius: 4px;
        border-left: 3px solid {{ .PrimaryColor }};
        padding: 16px 20px;
        margin: 1.25em 0 1.375em;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-all;
      }

      .f-fallback pre code {
        background-color: transparent;
        padding: 0;
        border: none;
        font-size: 0.8125em;
        line-height: 1.6;
        color: #333333;
      }
    </style>
    <!--[if mso]>
      <style type="text/css">
        .f-fallback {
          font-family: Arial, sans-serif;
        }
      </style>
    <![endif]-->
  </head>
  <body style="width: 100% !important; height: 100%; margin: 0; -webkit-text-size-adjust: none; background-color: #ffffff; color: #292929; font-family: Helvetica, Arial, sans-serif;">
    <span class="preheader" style="display: none !important; visibility: hidden; mso-hide: all; font-size: 1px; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden;"
      >Your latest codebase insights from Abstractions.</span
    >
    <table
      class="email-wrapper"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      bgcolor="#ffffff"
      style="width: 100%; margin: 0; padding: 0; background-color: #ffffff;"
    >
      <tr>
        <td align="center" style="font-family: Helvetica, Arial, sans-serif;">
          <table
            class="email-content"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            role="presentation"
            style="width: 100%; margin: 0; padding: 0;"
          >
            <tr>
              <td class="email-masthead" style="padding: 32px 0; text-align: center; border-bottom: 1px solid #eaeaec; font-family: Helvetica, Arial, sans-serif;">
                <a
                  href="{{ .SenderLink }}"
                  class="f-fallback email-masthead_name"
                  style="font-size: 16px; font-weight: bold; color: #A8AAAF; text-decoration: none;"
                >
                 <img
                   src="{{ .SenderLogo }}"
                   alt="{{ .SenderName }}"
                   width="180"
                   class="email-masthead_logo"
                   style="width: 180px; max-width: 100%; height: auto; display: block; margin: 0 auto; border: none;"
                 />
                </a>
              </td>
            </tr>
            <!-- Email Body -->
            <tr>
              <td
                class="email-body"
                width="680"
                cellpadding="0"
                cellspacing="0"
                style="width: 100%; margin: 0; padding: 0;"
              >
                <!--[if mso]>
                <table role="presentation" align="center" width="680" cellpadding="0" cellspacing="0"><tr><td>
                <![endif]-->
                <table
                  class="email-body_inner"
                  align="center"
                  width="680"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                  bgcolor="#ffffff"
                  style="width: 680px; max-width: 680px; margin: 0 auto; background-color: #ffffff; border-top: 3px solid {{ .PrimaryColor }};"
                >
                  <!-- Body content -->
                  <tr>
                    <td class="content-cell" style="padding: 40px 48px; font-family: Helvetica, Arial, sans-serif;">
                      <div class="f-fallback">
                        {{ if .Title }}
                        <h1 style="margin: 0 0 1.25em; color: #111111; font-size: 30px; font-weight: bold; text-align: left; line-height: 1.25;">{{ .Title }}</h1>
                        {{ end }}
                        {{ .BodyHTML }}
                        <!-- Action -->
                        {{ if .CTAText }}
                        <table
                          class="body-action"
                          align="center"
                          width="100%"
                          cellpadding="0"
                          cellspacing="0"
                          role="presentation"
                          style="width: 100%; margin: 30px auto; padding: 0; text-align: center;"
                        >
                          <tr>
                            <td align="left" style="font-family: Helvetica, Arial, sans-serif;">
                              <!-- Border based button
           https://litmus.com/blog/a-guide-to-bulletproof-buttons-in-email-design -->
                              <table
                                width="100%"
                                border="0"
                                cellspacing="0"
                                cellpadding="0"
                                role="presentation"
                              >
                                <tr>
                                  <td align="left" style="font-family: Helvetica, Arial, sans-serif;">
                                    <a
                                      href="{{ .CTALink }}"
                                      class="f-fallback button"
                                      target="_blank"
                                      style="background-color: {{ .PrimaryColor }}; border-top: 10px solid {{ .PrimaryColor }}; border-right: 18px solid {{ .PrimaryColor }}; border-bottom: 10px solid {{ .PrimaryColor }}; border-left: 18px solid {{ .PrimaryColor }}; display: inline-block; color: #ffffff; text-decoration: none; border-radius: 3px; box-sizing: border-box; -webkit-text-size-adjust: none;"
                                      >{{ .CTAText }}</a
                                    >
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>
                        {{ end }}
                        <!-- Sub copy -->
                        {{ if .CTALink }}
                        <table class="body-sub" role="presentation" style="margin-top: 25px; padding-top: 25px; border-top: 1px solid #eaeaec;">
                          <tr>
                            <td style="font-family: Helvetica, Arial, sans-serif;">
                              <p class="f-fallback sub" style="margin: 0.4em 0 1.375em; font-size: 13px; line-height: 1.75; color: #292929;">
                                If you're having trouble with the button above,
                                copy and paste the URL below into your web
                                browser.
                              </p>
                              <p class="f-fallback sub" style="margin: 0.4em 0 1.375em; font-size: 13px; line-height: 1.75; color: #292929;">{{ .CTALink }}</p>
                            </td>
                          </tr>
                        </table>
                        {{ end }}
                      </div>
                    </td>
                  </tr>
                </table>
                <!--[if mso]>
                </td></tr></table>
                <![endif]-->
              </td>
            </tr>
            <tr>
              <td style="font-family: Helvetica, Arial, sans-serif;">
                <!--[if mso]>
                <table role="presentation" align="center" width="680" cellpadding="0" cellspacing="0"><tr><td>
                <![endif]-->
                <table
                  class="email-footer"
                  align="center"
                  width="680"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                  style="width: 680px; max-width: 680px; margin: 0 auto; text-align: center;"
                >
                  <tr>
                    <td class="content-cell" align="left" style="padding: 40px 48px; padding-top: 24px; border-top: 1px solid #eaeaec; font-family: Helvetica, Arial, sans-serif;">
                      <p class="f-fallback sub align-left" style="margin: 0.4em 0 1.375em; font-size: 13px; line-height: 1.75; text-align: left; color: #A8AAAF;">
                        {{ .EmailReason }}
                      </p>
                      <p class="f-fallback sub align-left" style="margin: 0.4em 0 1.375em; font-size: 13px; line-height: 1.75; text-align: left; color: #A8AAAF;">
                        {{ .SenderLegalName }}
                        <br />
                        {{ .SenderAddress }}
                        <br />
                        {{ if .UnsubscribeLink }}
                        <a href="{{ .UnsubscribeLink }}" class="f-fallback" style="color: {{ .PrimaryColor }};">
                          Unsubscribe
                        </a>
                        {{ end }} {{ if .PreferencesLink }} |
                        <a href="{{ .PreferencesLink }}" class="f-fallback" style="color: {{ .PrimaryColor }};">
                          Manage Preferences
                        </a>
                        {{ end }}
                      </p>
                    </td>
                  </tr>
                </table>
                <!--[if mso]>
                </td></tr></table>
                <![endif]-->
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
