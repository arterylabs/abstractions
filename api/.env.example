# Copy to api/.env and fill in real values.
# Never commit api/.env.

# --- Core ---
ENV=development
PORT=1234

# JWT signing secrets (use long random strings in production)
SIGNING_KEY=change-me-signing-key
TOKEN_REFRESH_KEY=change-me-token-refresh-key

# Exactly 32 characters (used for encrypting stored secrets)
ENCRYPTION_KEY_32_BIT=0123456789abcdef0123456789abcdef

# Public URLs (used in emails, OAuth redirects, and links)
API_URL=http://localhost:1234
CLIENT_URL=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=abstractions
DATABASE_PORT=5432
DATABASE_SSL_MODE=disable

# --- Redis (job queue / workers) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- File storage (S3-compatible) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_STORAGE_ENDPOINT=
AWS_STORAGE_BUCKET=

# --- Email ---
# EMAIL_PROVIDER selects the sender: "cloudflare" (default) or "ses" (AWS SES, fallback).
EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# In development, all outbound email is redirected here instead of real recipients
DEVELOPMENT_EMAIL=you@example.com

# --- OAuth (optional; leave empty to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Platform-default AI keys (optional) ---
# Workspaces can also supply their own keys in AI settings.
# Set DISABLE_DEFAULT_AI_USAGE=true to force bring-your-own-key only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DISABLE_DEFAULT_AI_USAGE=false

# --- Optional integrations ---
SLACK_APP_EVENTS_WEBHOOK_URL=
