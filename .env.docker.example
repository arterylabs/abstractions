# Docker-specific environment overrides
# Start from your existing api/.env and change the values below.
#
# On Linux (including production servers), Docker containers reach the host via
# the special hostname "host.docker.internal" which is mapped by docker-compose
# via extra_hosts. On Docker Desktop (Mac/Windows) this works out of the box.

# --- Values that differ from local development ---

DATABASE_HOST=host.docker.internal
REDIS_HOST=host.docker.internal

# API_URL should be the publicly accessible URL of the API container
API_URL=http://localhost:1234

# CLIENT_URL should be the publicly accessible URL of the frontend container
CLIENT_URL=http://localhost:3000

# --- Frontend build arg ---
# Set this in your shell or a root-level .env before running `docker compose build`
# so Next.js bakes the correct API URL into the frontend bundle.
#
# NEXT_PUBLIC_API_URL=http://localhost:1234
#
# For production, set this to the public API domain, e.g.:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
